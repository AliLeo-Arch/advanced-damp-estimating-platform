# Advanced Damp Estimating — environment variables (copy to `.env` in `backend/`)

# Required before live use — change from default
JWT_SECRET=change-me-to-a-long-random-secret

# Optional overrides
# APP_ENV=local_production
# DATABASE_URL=sqlite:///./data/advanced_damp_local_prod.db
# SERVE_FRONTEND=true

# Vercel / split frontend+API
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# CORS_ALLOW_VERCEL_PREVIEWS=true
# On Vercel, SQLite defaults to /tmp (ephemeral). Prefer Postgres for lasting data:
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
