# Trade Estimating & Quoting — environment variables (copy to `.env` in `backend/`)

# Required before live use — change from default
JWT_SECRET=change-me-to-a-long-random-secret

# Optional overrides
# APP_ENV=local_production
# Demo login helpers (credentials on the sign-in page) are off for local_production.
# Enable them for training/demo builds:
# APP_ENV=demo
# SHOW_DEMO_HELPERS=true
# Primary office deployment uses local SQLite:
# DATABASE_URL=sqlite:///./data/trade_estimating_local_prod.db
# SERVE_FRONTEND=true

# Split frontend + API (e.g. Vercel demo)
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# CORS_ALLOW_VERCEL_PREVIEWS=true
# On Vercel, SQLite under /tmp is ephemeral (demo-only). Office production stays on local SQLite.
